# Compose publishes Streamlit only on the VPS loopback interface.
APP_HOST=127.0.0.1
APP_PORT=8501

# This directory must exist and be writable by UID/GID 10001.
SOLDICOM_DATA_DIR=/opt/vertico/data
HISTORY_DB_PATH=/app/data/historico.sqlite3

# Public DNS name used by Caddy to request and renew TLS certificates.
APP_DOMAIN=srv1935559.hstgr.cloud
